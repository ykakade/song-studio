{
  "name": "song-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && vite build",
    "start": "node server/index.ts",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"test/*.test.ts\"",
    "test:e2e": "node test/e2e/flow.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "mock:acestep": "node server/mock-acestep.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wavesurfer.js": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
