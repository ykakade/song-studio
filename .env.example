# --- Web app -----------------------------------------------------------------
# Address the app listens on. 127.0.0.1 = this machine only.
# HOST=0.0.0.0 makes it reachable from other devices on your network.
HOST=127.0.0.1
PORT=8787

# --- Music model (ACE-Step 1.5 REST API) --------------------------------------
# Start it with scripts/start-model-server.sh
ACESTEP_URL=http://127.0.0.1:8001
# New songs use the model's LM planner, which makes the vocals much clearer and
# costs about 10 s per song. "off" disables it.
# SONG_STUDIO_LM_PLANNER=on

# --- Chat model ---------------------------------------------------------------
# "anthropic" needs ANTHROPIC_API_KEY. "fake" is a scripted stand-in that needs
# no key (good for demos and tests; it does not understand free-form requests).
SONG_STUDIO_LLM=anthropic
ANTHROPIC_API_KEY=
# Optional: point the SDK at a proxy / gateway instead of api.anthropic.com
# ANTHROPIC_BASE_URL=
# Optional overrides
# SONG_STUDIO_MODEL=claude-sonnet-5-5
# SONG_STUDIO_EFFORT=medium            # low | medium | high | xhigh | max | none
# SONG_STUDIO_REFUSAL_FALLBACK=off     # server-side refusal fallback is on by default (first-party API only)

# --- Storage ------------------------------------------------------------------
# Each project is a folder in here (song.json, lyrics.md, takes/...).
# SONG_STUDIO_PROJECTS_DIR=~/Music/Songs
# SONG_STUDIO_DATA_DIR=./data

# --- Finding where the words are ------------------------------------------------
# After each take, Whisper (MLX, via uv) listens to it to place lines and sections.
# SONG_STUDIO_TIMING=on
